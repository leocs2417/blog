---
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer>
  <div class="wrap footer-layout">
    <span>© 2017 – 2026 Leo Chen</span>
    <div class="filing-links">
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">辽ICP备2025049397号-2</a>
      <a class="police-filing" href="https://beian.mps.gov.cn/#/query/webSearch?code=21021102002079" target="_blank" rel="noopener noreferrer">
        <img src={`${B}/assets/police-filing.png`} width="18" height="20" alt="">
        辽公网安备21021102002079号
      </a>
    </div>
    <a href="https://github.com/leocs2417" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.6 5.6.6 11.9c0 5 3.3 9.3 7.8 10.8.6.1.8-.2.8-.5v-2c-3.2.7-3.8-1.4-3.8-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.5 4.6-1.5 7.8-5.8 7.8-10.8C23.4 5.6 18.3.5 12 .5z"/></svg>
      GitHub
    </a>
  </div>
</footer>

<style>
  .footer-layout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .filing-links {
    display: contents;
  }

  .filing-links a {
    white-space: nowrap;
  }

  .police-filing img {
    flex: none;
  }

  @media (max-width: 820px) {
    .footer-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
    }

    .filing-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px 16px;
    }
  }
</style>
