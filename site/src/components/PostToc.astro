---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = tocItems.length >= 2;
---

{hasToc && (
  <aside class="toc" data-toc data-pagefind-ignore>
    <nav aria-label="文章目录">
      <div class="toc-title">目录 / TOC</div>
      <ul class="toc-list">
        {tocItems.map((item) => (
          <li class={`toc-item toc-depth-${item.depth}`}>
            <a href={`#${item.slug}`} data-heading-id={item.slug}>{item.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  function initPostToc() {
    const toc = document.querySelector('[data-toc]');
    if (!toc) return;

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-heading-id]'));
    const headings = links
      .map((link) => document.getElementById(link.dataset.headingId ?? ''))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    if (!links.length || !headings.length) return;

    let rafId = 0;
    let activeLink: HTMLAnchorElement | null = null;

    function clearCurrent() {
      links.forEach((link) => {
        link.classList.remove('cur');
        link.removeAttribute('aria-current');
      });
    }

    function setActive(heading: HTMLElement) {
      const link = links[headings.indexOf(heading)];
      if (!link) return;
      const isNewActive = link !== activeLink;
      clearCurrent();
      link.classList.add('cur');
      link.setAttribute('aria-current', 'location');
      if (isNewActive && toc.scrollHeight > toc.clientHeight) {
        const tocRect = toc.getBoundingClientRect();
        const linkRect = link.getBoundingClientRect();
        if (linkRect.top < tocRect.top + 8) {
          toc.scrollTop -= tocRect.top - linkRect.top + 16;
        } else if (linkRect.bottom > tocRect.bottom - 8) {
          toc.scrollTop += linkRect.bottom - tocRect.bottom + 16;
        }
      }
      activeLink = link;
    }

    function update() {
      const readingOffset = 116;
      const viewportBottom = window.innerHeight + window.scrollY;
      const isAtBottom =
        viewportBottom >= document.documentElement.scrollHeight - 4;

      let active = headings[0];
      for (const heading of headings) {
        const headingTop = heading.getBoundingClientRect().top + window.scrollY;
        if (headingTop <= window.scrollY + readingOffset) {
          active = heading;
        }
      }

      if (isAtBottom) {
        active = headings[headings.length - 1];
      }

      setActive(active);
    }

    function scheduleUpdate() {
      if (rafId) window.cancelAnimationFrame(rafId);
      rafId = window.requestAnimationFrame(() => {
        rafId = 0;
        update();
      });
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate);
    window.setTimeout(scheduleUpdate, 120);
    scheduleUpdate();
  }

  initPostToc();
</script>
