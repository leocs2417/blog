---
import type { CollectionEntry } from 'astro:content';
import { tagSlug, BASE } from '../lib/utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
  startIndex?: number;
}
const { posts, startIndex = 0 } = Astro.props;
---
<div class="post-list">
  {posts.map((post, i) => (
    <a class="post" href={`${BASE}posts/${post.data.slug}/`}>
      <span class="idx" aria-hidden="true">{String(startIndex + i + 1).padStart(2, '0')}</span>
      <div class="body">
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <div class="tags">
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>
    </a>
  ))}
</div>
