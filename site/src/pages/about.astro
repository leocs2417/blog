---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../lib/utils';
---
<BaseLayout title="关于 — Leo Chen" active="about">
  <main class="wrap" style="max-width:720px">
    <div style="display:flex; align-items:center; gap:28px; padding:56px 24px 40px">
      <img class="avatar" src={`${BASE}assets/avatar.jpeg`} alt="Leo Chen 的头像" width="96" height="96" style="width:96px;height:96px">
      <div>
        <h1 style="font-family:var(--font-display); font-size:34px; font-weight:700; letter-spacing:-.5px">Leo Chen<span style="color:var(--accent)">.</span></h1>
        <p style="margin-top:6px; color:var(--muted); font-size:15px">前端工程师 · 辽宁</p>
      </div>
    </div>
    <div style="padding:0 24px 64px">
      <h2 style="font-family:var(--font-display); font-size:20px; font-weight:700; margin:40px 0 16px">关于我</h2>
      <p style="color:#1e293b; margin:12px 0">一名前端工程师，主要使用 Vue / React 做业务开发，对浏览器渲染原理、性能优化和工程化有持续的兴趣。这里记录我在实践中的思考与踩坑笔记，希望对遇到同样问题的人有帮助。</p>

      <h2 style="font-family:var(--font-display); font-size:20px; font-weight:700; margin:40px 0 16px">技术方向</h2>
      <div style="display:flex; gap:10px; flex-wrap:wrap">
        <span class="tag">Vue</span><span class="tag">React</span><span class="tag">TypeScript</span>
        <span class="tag">Node.js</span><span class="tag">性能优化</span><span class="tag">工程化</span>
      </div>

      <h2 style="font-family:var(--font-display); font-size:20px; font-weight:700; margin:40px 0 16px">联系我</h2>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:8px">
        <a class="chip" href="https://github.com/leocs2417" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.6 5.6.6 11.9c0 5 3.3 9.3 7.8 10.8.6.1.8-.2.8-.5v-2c-3.2.7-3.8-1.4-3.8-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.5 4.6-1.5 7.8-5.8 7.8-10.8C23.4 5.6 18.3.5 12 .5z"/></svg>
          GitHub
        </a>
        <a class="chip" href="mailto:leochen.sat24@gmail.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          Email
        </a>
      </div>

      <h2 style="font-family:var(--font-display); font-size:20px; font-weight:700; margin:40px 0 16px">关于本站</h2>
      <div class="p-card" style="margin-top:16px; cursor:default">
        <ul style="list-style:none">
          <li style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--border); font-size:14px"><span style="color:var(--muted)">框架</span><span>Astro</span></li>
          <li style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--border); font-size:14px"><span style="color:var(--muted)">全文搜索</span><span>Pagefind</span></li>
          <li style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--border); font-size:14px"><span style="color:var(--muted)">部署</span><span>GitHub Pages + 自有服务器</span></li>
          <li style="display:flex; justify-content:space-between; padding:8px 0; font-size:14px"><span style="color:var(--muted)">开源</span><span>源码在 GitHub 上</span></li>
        </ul>
      </div>
    </div>
  </main>
</BaseLayout>
