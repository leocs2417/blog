---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../lib/utils';
---
<BaseLayout title="404 — Leo Chen">
  <main style="text-align:center; padding:120px 24px">
    <div style="font-family:var(--font-display); font-size:120px; font-weight:700; letter-spacing:-4px; line-height:1">4<span style="color:var(--accent)">0</span>4</div>
    <p style="margin-top:20px; color:var(--muted); font-size:16px">页面走丢了 —— 可能链接已失效，或者内容被移动到了别处。</p>
    <div style="margin-top:36px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap">
      <a class="btn" href={`${import.meta.env.BASE_URL}`}>← 返回首页</a>
      <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}tags/`}>浏览全部文章</a>
    </div>
  </main>
</BaseLayout>
