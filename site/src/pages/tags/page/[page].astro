---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { sortPosts } from '../../../lib/utils';

export async function getStaticPaths({ paginate }: any) {
  const all = sortPosts(await getCollection('posts'));
  return paginate(all, { params: { page: undefined }, pageSize: 8 });
}

const { page } = Astro.props;
---
<BaseLayout title={`标签 — 第 ${page.currentPage} 页 — Leo Chen`} active="tags">
  <main class="wrap">
    <div class="page-head">
      <h1>标签<span class="dot">.</span></h1>
      <p>共 {page.total} 篇文章 · 第 {page.currentPage} / {page.lastPage} 页</p>
    </div>

    <div class="section-title">全部文章 / All Posts</div>
    <PostList posts={page.data} startIndex={(page.currentPage - 1) * 8} />

    <div class="pager">
      {page.url.prev && (
        <a href={page.url.prev} aria-label="上一页" style="min-width:40px; height:40px; padding:0 14px; border-radius:999px; border:1px solid var(--border); background:var(--card); font-size:14px; display:inline-flex; align-items:center; justify-content:center">←</a>
      )}
      <span class="info">第 {page.currentPage} / {page.lastPage} 页</span>
      {page.url.next && (
        <a href={page.url.next} aria-label="下一页" style="min-width:40px; height:40px; padding:0 14px; border-radius:999px; border:1px solid var(--border); background:var(--card); font-size:14px; display:inline-flex; align-items:center; justify-content:center">→</a>
      )}
    </div>
  </main>
</BaseLayout>
